{
  "name": "vmsp-ptz",
  "version": "1.0.0",
  "description": "Camera PTZ control with React Router",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "tsx server/index.ts",
    "dev:no-mediamtx": "cross-env SKIP_MEDIAMTX=1 tsx server/index.ts",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "start:watch": "cross-env NODE_ENV=production tsx server/watchdog.ts",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/express": "^7.9.2",
    "@react-router/node": "^7.9.2",
    "@react-router/serve": "^7.9.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^165.0.0",
    "hls.js": "^1.6.14",
    "isbot": "^5.1.31",
    "lucide-react": "^0.553.0",
    "mediamtx-webrtc-react": "^0.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.2"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.2",
    "@types/express": "^5.0.5",
    "@types/node": "^22",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
