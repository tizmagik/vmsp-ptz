# Copy this file to .env and fill in your local values.
# Do not commit your real .env file with secrets.

# HTTP server
PORT=8111
NODE_ENV=development

# MediaMTX startup toggle
# Set to 1 to skip launching mediamtx.exe when running locally without a streamer.
SKIP_MEDIAMTX=0

# ChMeetings public calendar feed
# Used by the server-only /api/chmeetings/events endpoint.
CHMEETINGS_API_KEY=your_chmeetings_api_key_here

# YouTube OAuth
# Required for /api/yt/auth, /api/yt/callback, and broadcast updates.
YOUTUBE_CLIENT_ID=your_google_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:8111/api/yt/callback

# Windows host audio playback
# Used by server/audio.ts when selecting a playback device.
DEFAULT_AUDIO_DEVICE=Speakers
BELL_AUDIO_DEVICE_SEARCH=usb-c
